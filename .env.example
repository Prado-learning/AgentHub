# Copy this file to .env and fill in only the providers you use.
# Never commit .env or real API keys.

ENABLE_REAL_LLM=false
ENABLE_LLM_PLANNER=false
LLM_TIMEOUT_SECONDS=30
# Retry transient LLM failures (429/5xx/timeout) with exponential backoff.
# Total attempts = LLM_MAX_RETRIES + 1; backoff = LLM_RETRY_BASE_SECONDS * 2^n.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
DEFAULT_MODEL_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL_NAME=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=

# Optional external CLI adapters
CODEX_MODE=llm
CODEX_COMMAND=
CLAUDE_CODE_COMMAND=
OPENCODE_COMMAND=
AGENT_CLI_TIMEOUT_SECONDS=180


# Local runtime settings. Leave AGENTHUB_DATA_DIR empty to use agent-workspace.
AGENTHUB_DATA_DIR=
RUN_TIMEOUT_SECONDS=300
RUN_MAX_LLM_CALLS=24
# Redis is optional. With no URL, caching is disabled.
GATEWAY_ENABLED=true
REDIS_URL=
AGENT_DEBUG=1

# Sandbox boundary for every run. These defaults preserve the pre-sandbox
# behaviour; tighten them deliberately.
AGENTHUB_SANDBOX_BACKEND=local
# Egress for processes the sandbox starts: none | model_only | allowlist | inherit
# AGENTHUB_SANDBOX_NETWORK=inherit
# Resource ceilings applied to the managed process tree (empty = no ceiling).
# Windows enforces all three via the job object; POSIX enforces CPU, memory
# and open files via setrlimit. RLIMIT_NPROC is deliberately not applied
# because it is accounted per user and would throttle AgentHub itself.
# AGENTHUB_SANDBOX_CPU_SECONDS=
# AGENTHUB_SANDBOX_MEMORY_MB=
# AGENTHUB_SANDBOX_MAX_PROCESSES=
# Comma-separated extra environment variables a sandboxed CLI may inherit.
# Anything not on the allow-list is stripped from child processes.
# AGENTHUB_SANDBOX_EXTRA_ENV=

# Copy this file to .env and fill in only the providers you use.
# Never commit .env or real API keys.

ENABLE_REAL_LLM=false
ENABLE_LLM_PLANNER=false
LLM_TIMEOUT_SECONDS=180
# Retry transient LLM failures (429/5xx/timeout) with exponential backoff.
# Total attempts = LLM_MAX_RETRIES + 1; backoff = LLM_RETRY_BASE_SECONDS * 2^n.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
DEFAULT_MODEL_PROVIDER=stepfun

OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL_NAME=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=

# Optional external CLI adapters
CODEX_MODE=llm
CODEX_COMMAND=
CLAUDE_CODE_COMMAND=
OPENCODE_COMMAND=
AGENT_CLI_TIMEOUT_SECONDS=180

